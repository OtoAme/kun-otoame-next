// Control revisions and maintenance rounds are independent of health evidence.
model patch_resource_link_maintenance {
  id               Int       @id @default(autoincrement())
  original_link_id Int
  link_version     Int
  revision         Int       @default(0)
  latest_round     Int       @default(0)
  frozen           Boolean   @default(false)
  stopped_at       DateTime?
  stop_note        String    @default("") @db.VarChar(1007)
  patch_id         Int
  link_id          Int?
  link             patch_resource_link? @relation(fields: [link_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  resource_id      Int?
  // Historical scalar: link-only writes must not take a parent FK row lock.
  owner_id         Int?
  owner            user? @relation("link_maintenance_owner", fields: [owner_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  events           patch_resource_link_maintenance_event[]
  created          DateTime @default(now())
  updated          DateTime @updatedAt

  @@unique([original_link_id, link_version], map: "link_maintenance_target_key")
  @@index([link_id])
  @@index([resource_id])
  @@index([owner_id])
}

model patch_resource_link_maintenance_event {
  id                Int       @id @default(autoincrement())
  control_id        Int
  control           patch_resource_link_maintenance @relation(fields: [control_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  round             Int
  state             String    @default("pending") @db.VarChar(16)
  active_key        String?   @unique @db.VarChar(64)
  source            String    @default("report") @db.VarChar(16)
  snoozed_until     DateTime?
  publisher_notified_at DateTime?
  responded_at      DateTime?
  outcome           String?   @db.VarChar(16)
  note              String    @default("") @db.VarChar(1007)
  result_notified_at DateTime?
  case_id           Int?
  case              ops_case? @relation(fields: [case_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  participants      patch_resource_link_maintenance_participant[]
  created           DateTime  @default(now())
  updated           DateTime  @updatedAt

  @@unique([control_id, round], map: "link_maintenance_event_round_key")
  @@index([case_id])
  @@index([state, snoozed_until])
}

model patch_resource_link_maintenance_participant {
  event_id Int
  event    patch_resource_link_maintenance_event @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_id  Int
  user     user @relation("link_maintenance_participant", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created  DateTime @default(now())

  @@id([event_id, user_id])
  @@index([user_id])
}
