model shoutbox {
  id         Int    @id @default(autoincrement())
  user_id    Int
  request_id String @db.VarChar(64)
  content    String @db.VarChar(500)
  link       String @default("") @db.VarChar(1000)

  official Boolean @default(false)
  level    String  @default("normal") @db.VarChar(16)
  status   Int     @default(0)
  cost     Int     @default(0)

  patch_id Int?
  patch    patch? @relation(fields: [patch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user     user   @relation("shoutbox_author", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  effective_from DateTime?
  effective_to   DateTime?
  edited_at      DateTime?
  hidden_at      DateTime?
  refunded_at    DateTime?

  reports patch_report[]

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@unique([user_id, request_id])
  @@index([status, created(sort: Desc), id(sort: Desc)])
  @@index([patch_id, status, created(sort: Desc)])
  @@index([user_id, created(sort: Desc), id(sort: Desc)])
  @@index([official, status, effective_to])
}
