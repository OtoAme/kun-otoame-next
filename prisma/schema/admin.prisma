model admin_log {
  id      Int    @id @default(autoincrement())
  type    String
  content String @db.VarChar(10007)
  status  Int    @default(0)

  user_id Int
  user    user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  created DateTime @default(now())
  updated DateTime @updatedAt

  // Today's processed count, polled per administrator every minute.
  @@index([user_id, created])
  // The log page and the overview's recent operations, newest first.
  @@index([created(sort: Desc), id(sort: Desc)])
}
