// Module 06 facts. Queue membership is derived from these rows; this file does
// not store candidates, official flags, or anonymous credit.

/// One optional row per card. Absence means not ignored and not dismissed.
/// Resource deletion removes the row. Operator ids stay scalars.
model patch_resource_backup_state {
  resource_id            Int       @id
  resource               patch_resource @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ignored_at             DateTime?
  ignored_by_user_id     Int?
  ignore_reason          String?   @db.VarChar(500)
  rebackup_dismissed_at  DateTime?
}

/// A dismissed or merged user-card/staff-card pair. Resource ids are scalars
/// with no foreign key, so the row remains after the staff card is deleted.
/// There is no partial unique index: the pair itself is unique.
model patch_resource_merge_record {
  id                   Int      @id @default(autoincrement())
  user_resource_id     Int
  staff_resource_id    Int
  patch_id             Int
  section              String   @db.VarChar(107)
  status               String   @db.VarChar(16)
  handled_at           DateTime
  handled_by_user_id   Int
  detail               Json

  @@unique([user_resource_id, staff_resource_id], map: "patch_resource_merge_record_pair_key")
  @@index([staff_resource_id, status], map: "patch_resource_merge_record_staff_status_idx")
}

/// Durable object-cleanup credential. The resource id is a scalar, so deleting
/// the card does not drop the obligation. object_key is the storage key only.
model patch_resource_file_cleanup {
  id               Int      @id @default(autoincrement())
  object_key       String   @unique @db.VarChar(1007)
  resource_id      Int
  status           String   @db.VarChar(16)
  failure_category String?  @db.VarChar(64)
  created          DateTime @default(now())
  updated          DateTime @updatedAt

  @@index([status, created, id], map: "patch_resource_file_cleanup_replay_idx")
}

/// Links whose attached_at was null during the module 06 backfill. Later
/// correction may change only these rows, and only while they still hold the
/// value this backfill wrote.
model patch_resource_link_attached_at_fill {
  link_id          Int      @id
  link             patch_resource_link @relation(fields: [link_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resource_id      Int
  link_created     DateTime
  resource_created DateTime
  fill_source      String   @db.VarChar(32)
  filled_value     DateTime
  created          DateTime @default(now())
}
