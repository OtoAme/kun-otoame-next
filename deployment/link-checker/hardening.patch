+// Package providerhttp restricts this checker's five provider HTTP destinations.
+package providerhttp
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"slices"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// Share authorities and API authorities are distinct; no wildcard/subdomain rule.
+var pan123Hosts = []string{
+	"123pan.com", "www.123pan.com", "123684.com", "www.123684.com",
+	"123865.com", "www.123865.com", "123912.com", "www.123912.com",
+}
+
+var shareHosts = append([]string{
+	"pan.quark.cn", "drive.uc.cn", "pan.baidu.com", "caiyun.139.com", "yun.139.com",
+}, pan123Hosts...)
+
+var apiHosts = append([]string{
+	"drive-pc.quark.cn", "pc-api.uc.cn", "pan.baidu.com", "share-kd-njs.yun.139.com",
+}, pan123Hosts...)
+
+func allowedURL(u *url.URL, hosts []string) bool {
+	if u == nil || u.Scheme != "https" || u.User != nil || u.Opaque != "" {
+		return false
+	}
+	host := strings.ToLower(u.Hostname())
+	if !slices.Contains(hosts, host) {
+		return false
+	}
+	// Reject empty, non-default and noncanonical ports, including trailing colon.
+	return u.Host == u.Hostname() || u.Host == net.JoinHostPort(u.Hostname(), "443")
+}
+
+func ShareURLAllowed(u *url.URL) bool  { return allowedURL(u, shareHosts) }
+func Pan123URLAllowed(u *url.URL) bool { return allowedURL(u, pan123Hosts) }
+
+// Conservatively exclude special-use ranges, not merely RFC1918 addresses.
+var deniedPrefixes = func() []netip.Prefix {
+	var result []netip.Prefix
+	for _, cidr := range []string{
+		"0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
+		"169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24",
+		"192.88.99.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24",
+		"203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4",
+		"2001::/23", "2001:db8::/32", "2002::/16", "3fff::/20",
+	} {
+		result = append(result, netip.MustParsePrefix(cidr))
+	}
+	return result
+}()
+
+var globalV6 = netip.MustParsePrefix("2000::/3")
+
+func publicAddress(addr netip.Addr) bool {
+	if !addr.IsValid() || addr.Zone() != "" {
+		return false
+	}
+	addr = addr.Unmap()
+	if !addr.IsGlobalUnicast() || addr.IsPrivate() || addr.IsLoopback() || addr.IsLinkLocalUnicast() {
+		return false
+	}
+	if addr.Is6() && !globalV6.Contains(addr) {
+		return false
+	}
+	for _, prefix := range deniedPrefixes {
+		if prefix.Contains(addr) {
+			return false
+		}
+	}
+	return true
+}
+
+type lookupFunc func(context.Context, string, string) ([]netip.Addr, error)
+type dialFunc func(context.Context, string, string) (net.Conn, error)
+
+func providerDial(lookup lookupFunc, dial dialFunc) dialFunc {
+	return func(ctx context.Context, network, authority string) (net.Conn, error) {
+		host, port, err := net.SplitHostPort(authority)
+		if err != nil || port != "443" || !slices.Contains(apiHosts, strings.ToLower(host)) {
+			return nil, errors.New("provider authority rejected")
+		}
+		addresses, err := lookup(ctx, "ip", host)
+		if err != nil || len(addresses) == 0 {
+			return nil, errors.New("provider DNS unavailable")
+		}
+		// Reject mixed public/private answers before opening any connection.
+		for _, address := range addresses {
+			if !publicAddress(address) {
+				return nil, errors.New("provider DNS rejected")
+			}
+		}
+		for _, address := range addresses {
+			// Bind the vetted literal. The dialer must never resolve host a second time.
+			conn, err := dial(ctx, network, net.JoinHostPort(address.Unmap().String(), port))
+			if err == nil {
+				return conn, nil
+			}
+			if ctx.Err() != nil {
+				break
+			}
+		}
+		return nil, errors.New("provider connection unavailable")
+	}
+}
+
+type restrictedTransport struct{ base *http.Transport }
+
+func (t restrictedTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if !allowedURL(r.URL, apiHosts) {
+		return nil, errors.New("provider URL rejected")
+	}
+	return t.base.RoundTrip(r)
+}
+
+func NewClient(timeout time.Duration) *http.Client {
+	dialer := &net.Dialer{Timeout: 5 * time.Second}
+	transport := &http.Transport{
+		// No environment proxy: it would move DNS/dial outside this policy.
+		DialContext:         providerDial(net.DefaultResolver.LookupNetIP, dialer.DialContext),
+		TLSHandshakeTimeout: 5 * time.Second,
+		MaxIdleConns:        20, IdleConnTimeout: 30 * time.Second,
+	}
+	return &http.Client{
+		Timeout: timeout, Transport: restrictedTransport{transport},
+		// A redirect is an unverified provider response. Follow none.
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+}
+
+func ReadBody(body io.Reader, limit int64) ([]byte, error) {
+	raw, err := io.ReadAll(io.LimitReader(body, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(raw)) > limit {
+		return nil, errors.New("provider response too large")
+	}
+	return raw, nil
+}
+
+// Duplicate keys are ambiguous provider evidence. Unknown fields remain legal.
+func DecodeJSON(raw []byte, target any) error {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var value func(int) error
+	value = func(depth int) error {
+		if depth > 32 {
+			return errors.New("provider JSON nesting rejected")
+		}
+		token, err := decoder.Token()
+		if err != nil {
+			return err
+		}
+		delim, ok := token.(json.Delim)
+		if !ok {
+			return nil
+		}
+		if delim == '{' {
+			seen := make(map[string]bool)
+			for decoder.More() {
+				key, err := decoder.Token()
+				if err != nil {
+					return err
+				}
+				name, ok := key.(string)
+				folded := foldedJSONName(name)
+				if !ok || seen[folded] {
+					return errors.New("provider JSON key rejected")
+				}
+				seen[folded] = true
+				if err := value(depth + 1); err != nil {
+					return err
+				}
+			}
+		} else if delim == '[' {
+			for decoder.More() {
+				if err := value(depth + 1); err != nil {
+					return err
+				}
+			}
+		} else {
+			return errors.New("provider JSON delimiter rejected")
+		}
+		_, err = decoder.Token()
+		return err
+	}
+	if err := value(0); err != nil {
+		return err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return errors.New("provider JSON trailing data rejected")
+	}
+	return json.Unmarshal(raw, target)
+}
+
+// encoding/json v1 folds struct names by Unicode SimpleFold equivalence.
+// Canonicalize each key once, then use the per-object map; no pairwise scan.
+func foldedJSONName(name string) string {
+	return strings.Map(func(r rune) rune {
+		for {
+			next := unicode.SimpleFold(r)
+			if next <= r {
+				return next
+			}
+			r = next
+		}
+	}, name)
+}
+
+func ObjectData(raw json.RawMessage) bool {
+	var data map[string]json.RawMessage
+	return json.Unmarshal(raw, &data) == nil && len(data) > 0
+}
