# Copy to .env.worktree.local in the primary checkout and fill development values.
# Connections, JWT secret, site addresses and S3 prefix are generated by setup.
JWT_ISS="otoame"
JWT_AUD="otoame_admin"

KUN_VISUAL_NOVEL_EMAIL_FROM="OtoAme development"
KUN_VISUAL_NOVEL_EMAIL_HOST="127.0.0.1"
KUN_VISUAL_NOVEL_EMAIL_PORT="1025"
KUN_VISUAL_NOVEL_EMAIL_ACCOUNT="dev@example.invalid"
KUN_VISUAL_NOVEL_EMAIL_PASSWORD=""

KUN_VISUAL_NOVEL_S3_STORAGE_ACCESS_KEY_ID=""
KUN_VISUAL_NOVEL_S3_STORAGE_SECRET_ACCESS_KEY=""
KUN_VISUAL_NOVEL_S3_STORAGE_BUCKET_NAME="otoame-worktrees"
KUN_VISUAL_NOVEL_S3_STORAGE_ENDPOINT="https://s3.example.invalid"
KUN_VISUAL_NOVEL_S3_STORAGE_REGION="us-east-1"
NEXT_PUBLIC_KUN_VISUAL_NOVEL_S3_STORAGE_URL="https://images.example.invalid"
KUN_VISUAL_NOVEL_IMAGE_BED_HOST="images.example.invalid"
KUN_VISUAL_NOVEL_IMAGE_BED_URL="https://images.example.invalid"

BANGUMI_ACCESS_TOKEN=""
KUN_NEXTMOE_API_KEY=""
